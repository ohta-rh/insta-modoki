{
  "name": "insta-modoki",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev --port ${PORT:-3000}",
    "build": "opennextjs-cloudflare build",
    "start": "opennextjs-cloudflare preview --port ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "globals": "17.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
