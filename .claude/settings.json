{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./**/.env.local)", "Read(./.dev.vars)", "Read(./**/.dev.vars)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "b=\"$(git config insta.integrationBranch || echo main)\"; node scripts/ci-gate.mjs \"$b\" || true; node scripts/harness-drift.mjs \"$b\" || true"
          }
        ]
      }
    ]
  }
}
