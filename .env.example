# Per-slot settings for a worktree. `node scripts/slot.mjs prepare <N>` writes the real values
# to .dev.vars (read by wrangler; git-ignored). This file only lists the names. Never put values here.
SLOT=
PORT=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
AUTH_PEPPER=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
MEDIA_ORIGIN=
